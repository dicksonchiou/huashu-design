.DS_Store
**/.DS_Store

# Video render temp (render-video.js 产物)
.video-tmp-*/
**/.video-tmp-*/

# Personal asset index（个人真实数据，只保留 .example.json 模板）
assets/personal-asset-index.json

# 本機私有設定（不得提交）
.env
.env.local

# Voiceover 工作目录（旁白 mp3、timeline.json 临时产物，可重新生成）
**/_narration/
**/_narration_*/

# Node / editor / OS
node_modules/
*.swp
.idea/
.vscode/
Thumbs.db

# Verification artifacts（截图、临时测试脚本）
demos/_frames_*.png
demos/_verify.js
demos/_verify.mjs

# 开发/测试中间产物（skill 内部研发用，不分发给用户）
_style-research/
**/design-demos/

# Demo 大视频（用 GitHub Releases 分发，不进仓库膨胀）
demos/**/*.mp4
__pycache__/
